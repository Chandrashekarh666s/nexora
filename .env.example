# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include a database name, e.g. /nexora
MONGODB_URI=

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only if the frontend is hosted on a different origin than this server (CORS allow-list).
FRONTEND_URL=

# Used once by `npm run seed:faculty`, then delete these four lines.
FACULTY_NAME=
FACULTY_IDENTIFIER=
FACULTY_EMAIL=
FACULTY_INITIAL_PASSWORD=

# Coding Arena (Judge0). Leave empty and the arena says "execution not configured" instead of faking results.
# Self-hosted:  JUDGE0_API_URL=http://localhost:2358      Hosted (RapidAPI): JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Optional: a GitHub token with NO scopes raises the public API rate limit. SYNC_HOURS = how often linked profiles refresh.
GITHUB_TOKEN=
SYNC_HOURS=6

# One timezone for every streak and calendar day. 330 = IST (UTC+5:30).
INSTITUTION_TZ_OFFSET_MIN=330
